---
import HeroDesk from "../islands/HeroDesk";
import Base from "../layouts/Base.astro";
---

<Base title="Mercurian">
  <main class="min-h-screen overflow-x-clip bg-[#F7F7F3]">
    <div class="mx-auto w-full max-w-[90rem] px-6 pt-6 pb-16 sm:px-10 sm:pt-8 lg:px-12 lg:pb-24 xl:px-16">
      <header class="flex h-8 items-center justify-between">
        <h1
          aria-label="Mercurian"
          class="w-fit text-xl font-semibold [font-family:Fraunces,serif]"
        >
          Mercurian<span aria-hidden="true" class="text-[#A0492A]">.</span>
        </h1>
        <a
          class="inline-flex h-8 items-center gap-1.5 rounded-md border border-border bg-background/60 px-2.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
          href="https://github.com/mercurian-labs/astrolabe"
          rel="noopener"
          target="_blank"
        >
          <svg aria-hidden="true" class="size-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.02c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.3-5.27-1.29-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.5 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
            ></path>
          </svg>
          Try Astrolabe
        </a>
      </header>

      <section class="mt-16 max-w-3xl lg:mt-20" aria-labelledby="hero-heading">
        <h2
          id="hero-heading"
          class="text-5xl font-medium tracking-tight [font-family:Fraunces,serif]"
        >
          Chart twice, build once.
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
          Astrolabe is your agent development environment for building ambitious software. Every
          message, every plan edit, every code change is a checkpoint in a branching history. Return
          to any point, take a different direction, explore new ideas side by side, and merge the
          branches back into a single plan.
        </p>
      </section>

      <section
        aria-label="Mercurian planning space"
        class="relative mt-8 h-180 w-full overflow-hidden rounded-xl bg-[#13120A]"
      >
        <img
          class="absolute inset-0 size-full object-cover object-center"
          src="/mercury-globe-poster.png"
          alt=""
          aria-hidden="true"
          loading="eager"
          width="1920"
          height="1080"
        />

        <div
          data-hero-window
          class="absolute top-[9%] left-1/2 flex h-[85%] w-[94%] -translate-x-1/2 flex-col overflow-hidden rounded-[10px] bg-background lg:w-[83%]"
          style="box-shadow: 0 28px 70px rgba(0,0,0,.14), 0 14px 32px rgba(0,0,0,.10);"
        >
          <div
            class="flex h-7 shrink-0 items-center border-b border-border bg-muted/80 px-3 text-foreground"
          >
            <div class="flex items-center gap-1.5" aria-hidden="true">
              <span class="size-2 rounded-full bg-[#A0492A]/80"></span>
              <span class="size-2 rounded-full bg-amber-500/70"></span>
              <span class="size-2 rounded-full bg-emerald-600/65"></span>
            </div>
            <span class="absolute left-1/2 -translate-x-1/2 text-[11px] font-medium">
              Astrolabe
            </span>
          </div>
          <div class="min-h-0 flex-1">
            <HeroDesk client:only="react" />
          </div>
        </div>
      </section>
    </div>
    <footer class="border-t border-border">
      <div
        class="mx-auto flex w-full max-w-[90rem] items-center justify-between px-6 py-6 sm:px-10 lg:px-12 xl:px-16"
      >
        <div
          aria-label="Mercurian"
          class="w-fit text-base font-semibold [font-family:Fraunces,serif]"
        >
          Mercurian<span aria-hidden="true" class="text-[#A0492A]">.</span>
        </div>
        <p class="text-xs text-muted-foreground">© 2026 Mercurian, Inc.</p>
      </div>
    </footer>
  </main>
</Base>
