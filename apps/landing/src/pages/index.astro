---
import HeroDesk from "../islands/HeroDesk";
import Base from "../layouts/Base.astro";

const providers = [
  { name: "Claude Code", src: "/harnesses/claude-ai-icon.svg" },
  { name: "Codex", src: "/harnesses/openai_dark.svg" },
  { name: "Cursor", src: "/harnesses/cursor_light.svg" },
  { name: "Grok", src: "/harnesses/grok-dark.svg" },
  { name: "OpenCode", src: "/harnesses/opencode-dark.svg" },
] as const;
---

<Base title="Mercurian">
  <main class="min-h-screen overflow-x-clip bg-background">
    <div class="mx-auto w-full max-w-[90rem] px-6 py-12 sm:px-10 lg:px-12 lg:py-16 xl:px-16">
      <h1
        aria-label="Mercurian"
        class="relative z-10 w-fit px-3 py-2 text-2xl font-semibold sm:text-3xl [font-family:Fraunces,serif]"
      >
        Mercurian<span aria-hidden="true" class="text-[#A0492A]">.</span>
      </h1>

      <section class="mt-10 max-w-3xl" aria-labelledby="hero-heading">
        <h2 id="hero-heading" class="text-2xl font-medium tracking-tight">
          Plan in branches. Merge what works.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted-foreground">
          Every message and every plan edit is a commit in one branching, git-style history. Return
          to any point and take a different direction, explore open decisions side by side, then
          merge the branches back into a single plan — with fresh, compacted context instead of a
          rotting thread. Nothing is ever destroyed, and forks and merges are yours alone to make.
        </p>
      </section>

      <section
        aria-label="Mercurian planning space"
        class="relative mt-8 min-h-[30rem] w-full overflow-hidden rounded-xl lg:aspect-video lg:min-h-0"
      >
        <img
          class="absolute inset-0 size-full object-cover object-center"
          src="/mercury-globe-poster.png"
          alt=""
          aria-hidden="true"
          loading="eager"
          width="1920"
          height="1080"
        />

        <div
          class="absolute top-[9%] left-1/2 flex h-[85%] w-[94%] -translate-x-1/2 flex-col overflow-hidden rounded-[10px] bg-background lg:w-[83%]"
          style="box-shadow: 0 28px 70px rgba(0,0,0,.14), 0 14px 32px rgba(0,0,0,.10);"
        >
          <div
            class="flex h-7 shrink-0 items-center border-b border-border bg-muted/80 px-3 text-foreground"
          >
            <div class="flex items-center gap-1.5" aria-hidden="true">
              <span class="size-2 rounded-full bg-[#A0492A]/80"></span>
              <span class="size-2 rounded-full bg-amber-500/70"></span>
              <span class="size-2 rounded-full bg-emerald-600/65"></span>
            </div>
            <span class="absolute left-1/2 -translate-x-1/2 text-[11px] font-medium">
              Astrolabe
            </span>
          </div>
          <div class="min-h-0 flex-1">
            <HeroDesk client:only="react" />
          </div>
        </div>
      </section>

      <section
        class="mt-10 grid gap-8 pb-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:pb-16"
        aria-labelledby="providers-heading"
      >
        <div class="max-w-xl">
          <h2 id="providers-heading" class="text-2xl font-medium tracking-tight">
            Your agents. Your machine. No account.
          </h2>
          <p class="mt-4 text-base leading-relaxed text-muted-foreground">
            Mercurian plans with the coding agents you already have — Claude Code, Codex, Cursor,
            and more — switchable between turns, even mid-plan, with every branch recording exactly
            what it ran under. It runs on your machine, against your repositories, with no sign up
            required. Plans, history, and memory are plain text and git: yours to keep, wherever you
            go next.
          </p>
        </div>

        <ul class="grid min-w-0 grid-cols-3 gap-5 sm:grid-cols-5 sm:gap-3">
          {
            providers.map((provider) => (
              <li class="flex min-w-0 flex-col items-center gap-3">
                <span class="flex size-16 items-center justify-center rounded-xl bg-foreground p-3 dark:bg-background">
                  <img
                    alt={provider.name}
                    class="size-10 object-contain"
                    height="40"
                    src={provider.src}
                    width="40"
                  />
                </span>
                <span class="text-center text-xs font-medium text-foreground/75">
                  {provider.name}
                </span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </main>
</Base>
