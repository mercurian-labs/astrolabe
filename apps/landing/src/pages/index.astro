---
import GraphStory from "../components/GraphStory.astro";
import HeroCarousel from "../islands/HeroCarousel";
import Base from "../layouts/Base.astro";
import PlanArtifactDemo from "../islands/PlanArtifactDemo";
import PlanComposerDemo from "../islands/PlanComposerDemo";
import StatusVocabularyDemo from "../islands/StatusVocabularyDemo";
---

<Base title="Mercurian">
  <main class="relative isolate min-h-screen overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-20 overflow-hidden" aria-hidden="true">
      <img
        class="absolute top-1/2 right-[-32rem] h-auto w-[78rem] max-w-none -translate-y-1/2 sm:right-[-26rem] lg:right-[-18rem] xl:right-[-10rem]"
        src="/mercury-globe-poster.png"
        alt=""
        aria-hidden="true"
        loading="eager"
        width="1920"
        height="1080"
      />
    </div>
    <div
      class="pointer-events-none absolute inset-0 -z-10 lg:hidden"
      style="background: linear-gradient(to right, var(--background) 0%, var(--background) 35%, color-mix(in oklab, var(--background) 70%, transparent) 70%, color-mix(in oklab, var(--background) 35%, transparent) 100%);"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 -z-10 hidden lg:block"
      style="background: linear-gradient(to right, var(--background) 0%, var(--background) 18%, color-mix(in oklab, var(--background) 55%, transparent) 45%, transparent 75%);"
      aria-hidden="true"
    >
    </div>

    <div
      class="mx-auto flex min-h-screen w-full max-w-[90rem] flex-col justify-center px-6 py-12 sm:px-10 lg:px-12 lg:py-16 xl:px-16"
    >
      <h1
        aria-label="Mercurian"
        class="relative z-10 w-fit px-3 py-2 text-2xl font-semibold sm:text-3xl [font-family:Fraunces,serif]"
      >
        Mercurian<span aria-hidden="true" class="text-[#A0492A]">.</span>
      </h1>

      <div class="relative z-10 mt-8">
        <HeroCarousel client:only="react">
          <div slot="fallback" class="sr-only">
            <h2>Plan in branches. Merge what works.</h2>
            <p>Every message and every plan edit is a commit in one branching, git-style history. Return to any point and take a different direction, explore open decisions side by side, then merge the branches back into a single plan — with fresh, compacted context instead of a rotting thread. Nothing is ever destroyed, and forks and merges are yours alone to make.</p>
            <h2>Memory you can actually read.</h2>
            <p>Your project's design truth lives as atomic, linked markdown notes in a git repository you own. Nothing is captured behind your back — the assistant proposes an amendment, you confirm it, and it lands as a commit attributed to the plan it came from. Mercurian is a lens over your memory, never a silo for it: every note stays editable with any tool and portable out of the product entirely.</p>
            <h2>Your agents. Your machine. No account.</h2>
            <p>Mercurian plans with the coding agents you already have — Claude Code, Codex, Cursor, and more — switchable between turns, even mid-plan, with every branch recording exactly what it ran under. It runs on your machine, against your repositories, with no sign up required. Plans, history, and memory are plain text and git: yours to keep, wherever you go next.</p>
          </div>
        </HeroCarousel>
      </div>
    </div>
  </main>
  <GraphStory />

  <section
    aria-labelledby="plan-artifact-claim"
    class="mx-auto grid min-h-screen w-full max-w-6xl items-center gap-12 px-6 py-24 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:px-10"
  >
    <p id="plan-artifact-claim" class="max-w-xl text-3xl leading-tight font-medium tracking-tight sm:text-4xl">
      The current plan artifact is authoritative and visually stable.
    </p>
    <div class="flex h-[30rem] min-w-0 overflow-hidden rounded-2xl border border-border bg-background shadow-sm">
      <PlanArtifactDemo client:only="react" />
    </div>
  </section>

  <section
    aria-labelledby="plan-composer-claim"
    class="mx-auto grid min-h-screen w-full max-w-6xl items-center gap-12 px-6 py-24 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:px-10"
  >
    <div class="min-w-0 rounded-2xl border border-border bg-background py-4 shadow-sm lg:order-1">
      <PlanComposerDemo client:only="react" />
    </div>
    <p id="plan-composer-claim" class="max-w-xl text-3xl leading-tight font-medium tracking-tight sm:text-4xl lg:order-2">
      Suggestions are offers, not actions.
    </p>
  </section>

  <section
    aria-labelledby="status-vocabulary-claim"
    class="mx-auto grid min-h-screen w-full max-w-6xl items-center gap-12 px-6 py-24 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:px-10"
  >
    <p id="status-vocabulary-claim" class="max-w-xl text-3xl leading-tight font-medium tracking-tight sm:text-4xl">
      Status is economical — one strongest signal per plan.
    </p>
    <div class="min-w-0 rounded-2xl border border-border bg-background px-6 py-16 shadow-sm sm:px-10">
      <StatusVocabularyDemo client:only="react" />
    </div>
  </section>

  <section class="mx-auto flex min-h-screen max-w-4xl flex-col justify-center gap-8 px-6 py-24 text-center">
    <p class="text-4xl leading-tight font-medium tracking-tight sm:text-5xl">
      Mercurian turns engineering issues into plans.
    </p>
    <blockquote class="text-lg leading-relaxed text-muted-foreground sm:text-xl">
      "All issues can form plans, but not all plans are formed by issues."
    </blockquote>
  </section>
</Base>
