---
import HeroWindow from "./HeroWindow.astro";
import { phases } from "../scripts/tour-scenes.js";
---

          <!-- ───────────────────────────────────────── [01] Hero -->
          <section class="hero" id="top" aria-labelledby="hero-title">
            <div class="hero__head">
              <h1 id="hero-title" class="hero__title">Chart twice, build once.</h1>
              <p class="hero__lede">
                Astrolabe is an agent development environment: run the coding agents you already use,
                fork any turn to try a second direction, and ship each change with its docs.
              </p>
              <div class="hero__actions">
                <a class="btn btn--rust px px--on-rust" href="https://app.astrolabe.sh">
                  <span class="roll"><span>Try Astrolabe</span><span aria-hidden="true">Try Astrolabe</span></span>
                  <svg class="arw" aria-hidden="true"><use href="#i-arrow" /></svg>
                </a>
                <a class="btn px" href="#threads">
                  <span class="roll"><span><span class="hide-sm">See </span>how a thread works</span><span aria-hidden="true"><span class="hide-sm">See </span>how a thread works</span></span>
                  <svg class="arw" aria-hidden="true"><use href="#i-arrow" /></svg>
                </a>
              </div>
            </div>

            <!-- The tour's three phases. Without script the first is shown; while the tour plays the
                 running one fills; once it has played each replays from its phase. -->
            <div class="tour" data-tour>
              <ol class="tour__phases" aria-label="The tour's phases">
                <li><button type="button" class="tour__phase is-on" data-tour-phase disabled aria-current="step"><i aria-hidden="true"><span></span></i><span class="tag"><b>01</b> Threads</span></button></li>
                <li><button type="button" class="tour__phase" data-tour-phase disabled><i aria-hidden="true"><span></span></i><span class="tag"><b>02</b> Wikis</span></button></li>
                <li><button type="button" class="tour__phase" data-tour-phase disabled><i aria-hidden="true"><span></span></i><span class="tag"><b>03</b> Changes</span></button></li>
              </ol>
              <p class="tour__caption" data-tour-caption aria-live="polite">{phases[0].caption}</p>
            </div>

            <div class="panel">
              <div class="panel__print" aria-hidden="true"><i class="panel__olive"></i><i class="panel__ivory"></i></div>
              <div class="panel__slot">
                <figure class="poster">
                  <HeroWindow />
                </figure>
              </div>
            </div>
          </section>

<script>
  import "../scripts/tour.js";
</script>
