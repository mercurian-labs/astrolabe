---
import plate from "../data/sphinx-plate.json";

// The plate is a 1000-unit square: where the art's box sits in it, and the masks its layers print.
const place = ([x, y, w, h]: number[]) => `left:${x / 10}%;top:${y / 10}%;width:${w / 10}%;height:${h / 10}%`;
const art = (name: string) => `--art:url("${plate.assets}/${name}.webp")`;
---
          <!-- ───────────────────────────────────────── [10] Who it's for -->
          <section class="who" aria-labelledby="who-title" data-who>
            <div class="who__art">
              <figure class="plate" data-sphinx>
                <div class="plate__sheet">
                  <div class="plate__art" role="img" aria-label={plate.alt} style={place(plate.box)}>
                    <i class="plate__still plate__still--olive" style={art("still-olive")}></i>
                    <i class="plate__still plate__still--ink" style={art("still-ink")}></i>
                    <canvas class="plate__canvas"></canvas>
                    <i class="plate__lines" style={art("lines")}></i>
                    <i class="plate__outline" style={art("outline")}></i>
                  </div>
                  <figcaption class="plate__fig">{plate.fig}</figcaption>
                  <p class="plate__credit">
                    After a <a href={plate.source}>photograph by {plate.credit}</a>, inpainted and printed · <a href={plate.licenseUrl} rel="license">{plate.license}</a>
                  </p>
                </div>
              </figure>
              <span class="cross cross--tl" aria-hidden="true"></span>
              <span class="cross cross--br" aria-hidden="true"></span>
            </div>
            <div class="who__list">
              <p class="tag">[10] Who it's for</p>
              <h2 id="who-title" class="h2" data-reveal>For whoever is directing the agents.</h2>
              <ul class="acc">
                <li class="acc__item is-open">
                  <h3><button class="acc__btn" type="button" aria-expanded="true" aria-controls="acc-0" id="acc-0-btn">Solo developers<i class="pm" aria-hidden="true"></i></button></h3>
                  <div class="acc__panel" id="acc-0" role="region" aria-labelledby="acc-0-btn"><div><p>Ask one agent to plan, and let it hand the pieces to Codex and Claude, each in a worktree of its own.</p></div></div>
                </li>
                <li class="acc__item">
                  <h3><button class="acc__btn" type="button" aria-expanded="false" aria-controls="acc-1" id="acc-1-btn">Reviewers<i class="pm" aria-hidden="true"></i></button></h3>
                  <div class="acc__panel" id="acc-1" role="region" aria-labelledby="acc-1-btn"><div><p>Every pull request a task produced, and the wiki change that documents them, sit in one change group, so the code and its docs are read side by side and merge together.</p></div></div>
                </li>
                <li class="acc__item">
                  <h3><button class="acc__btn" type="button" aria-expanded="false" aria-controls="acc-2" id="acc-2-btn">Maintainers<i class="pm" aria-hidden="true"></i></button></h3>
                  <div class="acc__panel" id="acc-2" role="region" aria-labelledby="acc-2-btn"><div><p>Keep conventions and the decisions behind the code in a wiki of linked Markdown in git that every agent reads. Agent edits collect in a change request, and the wiki changes only when you merge.</p></div></div>
                </li>
                <li class="acc__item">
                  <h3><button class="acc__btn" type="button" aria-expanded="false" aria-controls="acc-3" id="acc-3-btn">People driving agents from their phone<i class="pm" aria-hidden="true"></i></button></h3>
                  <div class="acc__panel" id="acc-3" role="region" aria-labelledby="acc-3-btn"><div><p>The work runs on the computer where your code lives. Your phone tells you when an agent needs you, and you answer from there.</p></div></div>
                </li>
                <li class="acc__item">
                  <h3><button class="acc__btn" type="button" aria-expanded="false" aria-controls="acc-4" id="acc-4-btn">People comparing models<i class="pm" aria-hidden="true"></i></button></h3>
                  <div class="acc__panel" id="acc-4" role="region" aria-labelledby="acc-4-btn"><div><p>Give the same question to Codex in one fork and Claude Code in another, then read their diffs side by side.</p></div></div>
                </li>
              </ul>
            </div>
          </section>
