          <!-- ───────────────────────────────────────── [03] Problems -->
          <section class="problems" aria-labelledby="problems-title">
            <div class="head">
              <div class="head__main">
                <p class="tag">[03] The problem</p>
                <h2 id="problems-title" class="h2" data-reveal>Agents move fast. Changing course is the slow part.</h2>
              </div>
              <p class="body head__aside" data-reveal>
                In a plain chat, getting back to a good turn, trying a second idea beside it, or keeping what
                the agent worked out is all done by hand.
              </p>
            </div>
            <ol class="pcards" data-pcards>
              <li class="pcard" tabindex="0">
                <p class="pcard__rail tag"><span>Branching</span><span>[01]</span></p>
                <svg class="pcard__fig" viewBox="0 0 240 170" aria-hidden="true">
