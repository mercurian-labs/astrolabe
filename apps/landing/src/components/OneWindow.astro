---
// [10] One window: four cards built like [03]'s problem cards, each drawing one part of the app
// that answers them. The glyphs are the sprite's (Lucide, as the app uses them), inlined so the
// figures' hairline stroke rules reach them.
const glyphs = {
  msgs: `<path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2z" /><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1" />`,
  book: `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />`,
  repo: `<path d="M9 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v5" /><circle cx="13" cy="12" r="2" /><path d="M18 19c-2.8 0-5-2.2-5-5v8" /><circle cx="20" cy="19" r="2" />`,
  pr: `<circle cx="18" cy="18" r="3" /><circle cx="6" cy="6" r="3" /><path d="M13 6h3a2 2 0 0 1 2 2v7" /><path d="M6 9v12" />`,
  chat: `<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />`,
  file: `<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" />`,
  layers: `<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z" /><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65M22 12.65l-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65" />`,
  search: `<circle cx="11" cy="11" r="7.5" /><path d="m21 21-4.3-4.3" />`,
};
type Glyph = keyof typeof glyphs;
// An 8-unit glyph with its top-left corner at (x, y).
const at = (x: number, y: number) => `translate(${x} ${y}) scale(${8 / 24})`;

const rail: { glyph: Glyph; label: string }[] = [
  { glyph: "msgs", label: "Agents" },
  { glyph: "book", label: "Wikis" },
  { glyph: "repo", label: "Repositories" },
  { glyph: "pr", label: "Changes" },
];
const kinds: { glyph: Glyph; label: string; x: number; y: number; front?: boolean }[] = [
  { glyph: "chat", label: "Chat", x: 22, y: 28 },
  { glyph: "file", label: "Document", x: 72, y: 18, front: true },
  { glyph: "pr", label: "Pull request", x: 122, y: 28 },
  { glyph: "layers", label: "Change group", x: 172, y: 18 },
];
const results: { glyph: Glyph; label: string; kind: string; on?: boolean }[] = [
  { glyph: "msgs", label: "Add Apple Pay", kind: "Agent", on: true },
  { glyph: "file", label: "Payments", kind: "Wiki" },
  { glyph: "msgs", label: "Apple Pay button", kind: "Agent" },
];
---

          <!-- ───────────────────────────────────────── [10] One window -->
          <section class="window-strip" id="window" aria-labelledby="window-title">
            <div class="window-strip__head">
              <p class="tag">[10] One window</p>
              <h2 id="window-title" class="h3" data-reveal>Every kind of work, in one window.</h2>
            </div>
            <ol class="pcards">
              <li class="pcard" tabindex="0">
                <p class="pcard__rail tag"><span>Rail</span><span>[01]</span></p>
                <svg class="pcard__fig" viewBox="0 0 240 160" aria-hidden="true">
                  <rect class="pf-fr" x="92" y="20" width="132" height="124" />
                  <path class="pf-ink" d="M92 32H224" />
                  <circle class="pf-2" cx="99" cy="26" r="1.75" />
                  <circle class="pf-2" cx="105" cy="26" r="1.75" />
                  <circle class="pf-2" cx="111" cy="26" r="1.75" />
                  <path class="pf-2" d="M118 32V144M170 32V144" />
                  {
                    rail.map((item, i) => {
                      const y = 46 + i * 16;
                      return (
                        <>
                          <g class="pf-i pf-i--ink" transform={at(101, y - 4)} set:html={glyphs[item.glyph]} />
                          <path class="pf-c" d={`M82 ${y}H97`} />
                          <text class:list={["pf-lbl", { "pf-rs": i === 0 }]} x="78" y={y + 2.5} text-anchor="end">{item.label}</text>
                        </>
                      );
                    })
                  }
                  <path class="pf-rs" d="M95.5 42V50" />
                  <path class="pf-ink" d="M124 44H144" />
                  <path class="pf-2" d="M124 56H162M124 62H150M124 74H160M124 80H146M124 92H164M124 98H152M124 110H158M124 116H144" />
                  <path class="pf-2" d="M178 44H214M178 52H208M178 60H216M178 68H198M178 84H212M178 92H202" />
                  <path class="pf-2" d="M176 118H218V136H176Z" />
                  <path class="pf-ink" d="M182 123v8" />
                </svg>
                <h3 class="pcard__title">Four sections</h3>
                <p class="pcard__body">Agents, Wikis, Repositories and Changes, one icon each on the rail.</p>
              </li>
              <li class="pcard" tabindex="0">
                <p class="pcard__rail tag"><span>Tab bar</span><span>[02]</span></p>
                <svg class="pcard__fig" viewBox="0 0 240 160" aria-hidden="true">
                  <rect class="pf-fr" x="16" y="34" width="208" height="110" />
                  <path class="pf-ink" d="M16 58H68Q72 58 72 54V44Q72 40 76 40H114Q118 40 118 44V54Q118 58 122 58H224" />
                  <path class="pf-rs" d="M78 40.5H112" />
                  {
                    kinds.map((tab) => (
                      <>
                        <g class:list={["pf-i", { "pf-i--ink": tab.front }]} transform={at(tab.x + 5, 45)} set:html={glyphs[tab.glyph]} />
                        <path class={tab.front ? "pf-ink" : "pf-2"} d={`M${tab.x + 17} 49H${tab.x + 35}`} />
                        <path class={tab.front ? "pf-2" : "pf-c"} d={`M${tab.x + 39} 47l4 4m0-4l-4 4`} />
                        <path class="pf-c" d={`M${tab.x + 23} ${tab.y + 3}V${tab.front ? 38 : 44}`} />
                        <text class="pf-lbl" x={tab.x + 23} y={tab.y} text-anchor="middle">{tab.label}</text>
                      </>
                    ))
                  }
                  <path class="pf-c" d="M170 45V53" />
                  <path class="pf-ink" d="M28 74H84" />
                  <path class="pf-2" d="M28 86H196M28 94H180M28 102H204M28 110H160M28 124H190M28 132H150" />
                </svg>
                <h3 class="pcard__title">Tabs that open anywhere</h3>
                <p class="pcard__body">Chats, documents, pull requests and change groups open in any section's panes.</p>
              </li>
              <li class="pcard" tabindex="0">
                <p class="pcard__rail tag"><span>Panes</span><span>[03]</span></p>
                <svg class="pcard__fig" viewBox="0 0 240 160" aria-hidden="true">
                  <rect class="pf-fr" x="16" y="20" width="208" height="124" />
                  <path class="pf-2" d="M112 20V144" />
                  <path class="pf-ink" d="M16 38H20Q24 38 24 34V28Q24 24 28 24H60Q64 24 64 28V34Q64 38 68 38H112" />
                  <g class="pf-i pf-i--ink" transform={at(29, 27)} set:html={glyphs.chat} />
                  <path class="pf-ink" d="M41 31H56" />
                  <g class="pf-i pf-i--faint" transform={at(73, 27)} set:html={glyphs.file} />
                  <path class="pf-c" d="M85 31H98" />
                  <path class="pf-ink" d="M112 38H116Q120 38 120 34V28Q120 24 124 24H156Q160 24 160 28V34Q160 38 164 38H224" />
                  <g class="pf-i pf-i--ink" transform={at(125, 27)} set:html={glyphs.pr} />
                  <path class="pf-ink" d="M137 31H152" />
                  <path class="pf-2" d="M24 50H100M24 58H92M24 66H104M24 74H84M24 90H98M24 98H80M24 106H102M24 122H94M24 130H76" />
                  <path class="pf-2" d="M120 50H210M120 58H196M120 66H214M120 74H180" />
                  <path class="pf-c pf-dots" d="M86 40C88 70 112 100 142 108" />
                  <path class="pf-rs pf-dash" d="M117 88H219V139H117Z" />
                  <rect class="pf-fr" x="146" y="103" width="40" height="13" rx="3" />
                  <g class="pf-i pf-i--ink" transform={at(150, 105.5)} set:html={glyphs.file} />
                  <path class="pf-ink" d="M162 109.5H178" />
                  <path class="pf-fr" d="M180 112v11l3-2.8 2.2 4.8 2-.9-2.2-4.7h4.1Z" />
                </svg>
                <h3 class="pcard__title">Splits</h3>
                <p class="pcard__body">Drag a tab to an edge to split. Each thread keeps its own arrangement.</p>
              </li>
              <li class="pcard" tabindex="0">
                <p class="pcard__rail tag"><span>Menu</span><span>[04]</span></p>
                <svg class="pcard__fig" viewBox="0 0 240 160" aria-hidden="true">
                  <rect class="pf-fr" x="16" y="20" width="208" height="124" />
                  <path class="pf-ink" d="M16 32H224" />
                  <text class="pf-lbl" x="22" y="28.5">Claude</text>
                  <path class="pf-2" d="M24 42H210M24 50H198M24 58H214M24 66H204M24 74H212M24 82H196M24 90H206M24 98H200" />
                  <path class="pf-2" d="M24 112H216V136H24Z" />
                  <path class="pf-2" d="M30 120H118" />
                  <rect class="pf-ink" x="119" y="116.5" width="4" height="7" />
                  <text class="pf-lbl" x="30" y="131.5">Normal</text>
                  <rect class="pf-fr" x="48" y="38" width="144" height="66" />
                  <g class="pf-i pf-i--ink" transform={at(54, 42)} set:html={glyphs.search} />
                  <text class="pf-lbl pf-typed" x="66" y="48.5">Pay</text>
                  <path class="pf-ink" d="M83 42.5v7" />
                  <text class="pf-lbl" x="186" y="48.5" text-anchor="end">⌘K</text>
                  <path class="pf-2" d="M48 54H192" />
                  {
                    results.map((row, i) => {
                      const y = 64 + i * 14;
                      return (
                        <>
                          <g class="pf-i pf-i--ink" transform={at(56, y - 4)} set:html={glyphs[row.glyph]} />
                          <text class:list={["pf-lbl", { "pf-rs": row.on }]} x="68" y={y + 2.5}>{row.label}</text>
                          <text class="pf-lbl" x="186" y={y + 2.5} text-anchor="end">{row.kind}</text>
                        </>
                      );
                    })
                  }
                  <path class="pf-rs" d="M51.5 59V69" />
                </svg>
                <h3 class="pcard__title">Keyboard first</h3>
                <p class="pcard__body">Vim wherever you type. <kbd>⌘K</kbd> or <kbd>Space</kbd> opens the menu; search finds agents and documents.</p>
              </li>
            </ol>
          </section>
