          <!-- ───────────────────────────────────────── Close -->
          <section class="close" data-relight aria-labelledby="close-title">
            <div class="close__copy">
              <h2 id="close-title" class="display display--close" data-reveal>Start with a question.</h2>
              <p class="close__line" data-reveal>Open a thread on your own repository, and fork it from any checkpoint.</p>
              <a class="btn btn--rust px px--on-rust" href="https://app.astrolabe.sh">
                <span class="roll"><span>Try Astrolabe</span><span aria-hidden="true">Try Astrolabe</span></span>
                <svg class="arw" aria-hidden="true"><use href="#i-arrow" /></svg>
              </a>
            </div>
              <div class="sky" data-sight>
                <canvas class="relight__ground" data-relight-canvas aria-hidden="true"></canvas>
                <div class="relight__static" aria-hidden="true"><i class="relight__olive"></i><i class="relight__dark"></i><i class="relight__light"></i></div>
                <i class="ruler ruler--x" aria-hidden="true"></i>
                <i class="ruler ruler--y" aria-hidden="true"></i>
                <div class="sky__art">
                  <i class="sky__plate" aria-hidden="true"></i>
                  <div class="sky__instrument" data-model>
                    <noscript><img class="sky__static" src="/assets/art/astrolabe-static.svg" alt="A planispheric astrolabe with a plate for 40° N and a rete of twelve stars" /></noscript>
                  </div>
                </div>
                <span class="cross cross--tl" aria-hidden="true"></span>
                <span class="cross cross--tr" aria-hidden="true"></span>
                <span class="cross cross--bl" aria-hidden="true"></span>
                <span class="cross cross--br" aria-hidden="true"></span>
                <p class="tag sky__tag sky__tag--tl" aria-hidden="true">Fig. 3 · <span class="wide-only">Planispheric </span>astrolabe</p>
                <p class="tag sky__tag sky__tag--tr" data-plate>Plate for 40° N · Rete of twelve stars</p>
                <div class="sky__time" data-time hidden>
                  <p class="tag"><span class="sky__clock" data-clock>00:00</span> <span class="sky__date" data-date></span></p>
                  <p class="tag sky__desc" data-sky></p>
                </div>
                <div class="sky__wind" data-time hidden>
                  <p class="tag sky__hint"><span class="hover-only">Point to sight<span class="sky__sep"> · </span></span>Drag the rete to wind time</p>
                  <button class="sky__now" type="button" data-now>Now</button>
                </div>
                <span class="tag star-tip" data-star-tip hidden></span>
                <div class="sight" aria-hidden="true">
                  <svg class="sight__rule"><line x1="0" y1="0" x2="0" y2="0" /></svg>
                  <i class="sight__h"></i>
                  <i class="sight__v"></i>
                  <i class="sight__mx"></i>
                  <i class="sight__my"></i>
                  <span class="sight__read">ALT 00.0° · AZ 000.0°</span>
                </div>
              </div>
          </section>
<script>
  // The instrument announces each moment it shows; the ground listens, so it loads first.
  import "../scripts/relight.js";
  import "../scripts/instrument.js";
</script>
