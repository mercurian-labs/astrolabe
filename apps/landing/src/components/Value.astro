---
import marks from "../data/agent-marks.json";
---
          <!-- ───────────────────────────────────────── [02] Value -->
          <section id="why" class="value" aria-labelledby="value-title">
            <p class="tag value__tag">[02] Why Astrolabe</p>
            <div class="value__text">
              <h2 id="value-title" class="sr-only">Why Astrolabe</h2>
              <p class="manifesto" data-ink-words>
                Agents can write more code than you can read. You still answer for what ships. Astrolabe is
                built so you understand their work as fast as they make it.
              </p>
              <a class="btn px" href="#agents">
                <span class="roll"><span>Start with the agents</span><span aria-hidden="true">Start with the agents</span></span>
                <svg class="arw" aria-hidden="true"><use href="#i-arrow" /></svg>
              </a>
            </div>
            <div class="works">
              <div class="works__label">
                <p class="tag">Works with</p>
                <p class="works__note">
                  The agents installed on your computer, signed in with your own accounts, and any agent that
                  speaks <a href="https://agentclientprotocol.com">ACP, the Agent Client Protocol</a>.
                </p>
              </div>
              <ul class="works__list" aria-label="Supported agents">
                {
                  marks.agents.map((agent) => (
                    <li>
                      {"image" in agent ? (
                        <i class="works__mark works__mark--image" style={`--mark:url("${agent.image}")`} aria-hidden="true" />
                      ) : (
                        <svg class="works__mark" viewBox={agent.viewBox} aria-hidden="true">
                          {agent.paths.map((path) => (
                            <path
                              d={path.d}
                              fill-rule={"evenodd" in path ? "evenodd" : undefined}
                              fill-opacity={"faint" in path ? 0.3 : undefined}
                            />
                          ))}
                        </svg>
                      )}
                      {agent.name}
                    </li>
                  ))
                }
              </ul>
            </div>
          </section>
