---
// The hero's drawn window: Agents, Wikis and Changes in one app frame, driven by scripts/tour.js
// from the scene data in scripts/tour-scenes.js. As written (no script) it is the main tour's
// finished Agents state: the planner's thread with both subagents done and their results landed.
// Anything named data-k is a part the tour shows or hides; data-gone marks a part the finished
// still leaves out; data-only names the threads a part belongs to, and data-off hides it while
// another thread is on show.
//
// Subagents are drawn the way the app draws them (V2LifecycleRow, MessagesTimeline): a round mark
// with the provider's logo and a state dot, the task's title, its latest progress or result, and
// its elapsed time; several started together sit under one "N subagents" row; a finished one
// lands back in the parent as a row of its own. Children never appear in the sidebar, and their
// first message reads "Sent by another agent".

const SHOWN = "plan";
const off = (ids: string) => (ids.split(" ").includes(SHOWN) ? undefined : true);

type Step = { k: string; icon: string; text?: string; code?: string; more?: string; gone?: boolean };
const read = (k: string, path: string, more?: string): Step => ({ k, icon: "i-eye", text: "Read", code: path, more });
const edit = (k: string, path: string): Step => ({ k, icon: "i-square-pen", code: path });
const run = (k: string, command: string): Step => ({ k, icon: "i-terminal", code: command });
const live = (k: string): Step => ({ k, icon: "i-terminal", text: "Running command", gone: true });

const threads = [
  {
    id: "intents",
    parent: "Add Apple Pay to checkout",
    ask: "Add POST /payments/intents for Apple Pay: create a payment intent and return its client secret. Open a pull request when the tests pass.",
    steps: [
      read("intents-read", "payments/charge.ts", "+3 more"),
      edit("intents-e1", "payments/intents.ts"),
      edit("intents-e2", "payments/intents.test.ts"),
      live("intents-live"),
      run("intents-run", "pnpm test payments"),
    ],
    reply: "Added <code>POST /payments/intents</code>. It creates a payment intent for Apple Pay and returns the client secret. Tests pass; opened #512.",
  },
  {
    id: "button",
    parent: "Add Apple Pay to checkout",
    ask: "Add an Apple Pay button to checkout that calls POST /payments/intents. Show it only where Apple Pay can make payments.",
    steps: [
      read("button-read", "checkout/PayButtons.tsx", "+2 more"),
      edit("button-e1", "checkout/ApplePayButton.tsx"),
      edit("button-e2", "checkout/PayButtons.tsx"),
      live("button-live"),
      run("button-run", "pnpm test checkout"),
    ],
    reply: "The button shows where Apple Pay can make payments and falls back to the card form everywhere else. Opened #513.",
  },
  {
    id: "review",
    parent: "Fix the flaky login test",
    ask: "Review the fix for the flaky login test on fix/login-flake. Say what you would change.",
    steps: [read("review-read", "e2e/login.spec.ts"), run("review-diff", "git diff main")],
    reply: "The wait is right: the session cookie is the real signal. One change: assert the dashboard heading after the redirect, so a slow redirect fails loudly.",
  },
];

const models = [
  { ids: "plan s3", logo: "p-claude", name: "Claude Opus 5.5" },
  { ids: "button review", logo: "p-claude", name: "Claude Sonnet 5.5" },
  { ids: "intents flaky nightly", logo: "p-openai", name: "GPT-6.1-Sol" },
];

const tabs = [
  { id: "plan", family: "plan intents button", logo: "p-claude", title: "Add Apple Pay to checkout" },
  { id: "intents", family: "plan intents button", logo: "p-openai", title: "Payment intents API", k: "tab-intents" },
  { id: "button", family: "plan intents button", logo: "p-claude", title: "Apple Pay button", k: "tab-button" },
  { id: "flaky", family: "flaky review", logo: "p-openai", title: "Fix the flaky login test" },
  { id: "review", family: "flaky review", logo: "p-claude", title: "Review the login test fix", k: "tab-review" },
  { id: "s3", family: "s3", logo: "p-claude", title: "Move uploads to S3" },
  { id: "nightly", family: "nightly", logo: "p-openai", title: "Copy old uploads to S3" },
];
---

<div class="app app--poster app--tour" data-tour-app data-section="agents" data-thread="plan" data-cpane="group" data-edits="accepted" data-merge="on" aria-hidden="true">
  <div class="tb">
    <div class="tb__cap">
      <span class="lights"><i></i><i></i><i></i></span>
      <svg class="ico"><use href="#i-panel" /></svg>
      <span class="spacer"></span>
      <svg class="ico ico--sm"><use href="#i-left" /></svg>
      <svg class="ico ico--sm ico--faint"><use href="#i-right" /></svg>
    </div>

    <!-- Agents: the chat tabs over the chat. -->
    <div class="tb__strip tb__strip--pane tb__strip--main" data-in="agents">
      <span class="lights lights--crop"><i></i><i></i><i></i></span>
      {
        tabs.map((tab) => (
          <span class:list={["tab", { "is-front is-focus": tab.id === SHOWN }]} data-tab={tab.id} data-p={`tab-${tab.id}`} data-only={tab.family} data-off={off(tab.family)} data-k={tab.k}>
            <svg class="logo"><use href={`#${tab.logo}`} /></svg>
            <span class="tab__title">{tab.title}</span>
            <svg class="ico ico--xs"><use href="#i-x" /></svg>
          </span>
        ))
      }
      <svg class="ico ico--muted"><use href="#i-plus" /></svg>
      <span class="spacer"></span>
      <svg class="ico ico--muted"><use href="#i-panel-r" /></svg>
    </div>

    <!-- Wikis and Changes: one pane of tabs across the main area. -->
    <div class="tb__strip tb__strip--pane tb__strip--main" data-in="wikis">
      <span class="lights lights--crop"><i></i><i></i><i></i></span>
      <span class="tab is-front is-focus"><svg class="ico ico--xs"><use href="#i-file" /></svg><span class="tab__title">Payments</span><svg class="ico ico--xs"><use href="#i-x" /></svg></span>
      <span class="tab"><svg class="ico ico--xs"><use href="#i-file" /></svg><span class="tab__title">Checkout</span></span>
      <span class="tab tab--narrow-off"><svg class="ico ico--xs"><use href="#i-merge" /></svg><span class="tab__title">Add Apple Pay to checkout</span></span>
      <svg class="ico ico--muted"><use href="#i-plus" /></svg>
      <span class="spacer"></span>
      <svg class="ico ico--muted"><use href="#i-more" /></svg>
    </div>
    <div class="tb__strip tb__strip--pane tb__strip--main" data-in="changes">
      <span class="lights lights--crop"><i></i><i></i><i></i></span>
      <span class="tab is-front is-focus" data-cp="group" data-p="cp-group"><svg class="ico ico--xs"><use href="#i-layers" /></svg><span class="tab__title">Add Apple Pay to checkout</span><svg class="ico ico--xs"><use href="#i-x" /></svg></span>
      <span class="tab" data-cp="pr" data-p="cp-pr"><svg class="ico ico--xs"><use href="#i-pr" /></svg><span class="tab__title">#512 Payment intents API</span><svg class="ico ico--xs"><use href="#i-x" /></svg></span>
      <span class="tab tab--narrow-off"><svg class="ico ico--xs"><use href="#i-pr" /></svg><span class="tab__title">#513 Apple Pay button</span></span>
      <svg class="ico ico--muted"><use href="#i-plus" /></svg>
      <span class="spacer"></span>
      <svg class="ico ico--muted"><use href="#i-more" /></svg>
    </div>
  </div>

  <div class="pb">
    <nav class="rail">
      <span class="rail__mark"><img src="/assets/brand/monogram.svg" alt="" /></span>
      <span class="rail__item" data-go="agents" title="Agents"><svg class="ico"><use href="#i-msgs" /></svg></span>
      <span class="rail__item" data-go="wikis" title="Wikis"><svg class="ico"><use href="#i-book" /></svg></span>
      <span class="rail__item" title="Repositories"><svg class="ico"><use href="#i-repo" /></svg></span>
      <span class="rail__item" data-go="changes" title="Changes"><svg class="ico"><use href="#i-pr" /></svg></span>
      <span class="rail__item" title="Usage"><svg class="ico"><use href="#i-usage" /></svg></span>
      <span class="rail__fill"></span>
      <span class="rail__item" title="Settings"><svg class="ico"><use href="#i-settings" /></svg></span>
    </nav>
    <i class="pb__corner"></i>

    <!-- ───────────── Agents: top-level threads only; subagents open from their parent. -->
    <aside class="side" data-in="agents">
      <div class="side__head">
        <span class="side__title">Agents</span>
        <span class="side__tools"><svg class="ico"><use href="#i-search" /></svg><svg class="ico"><use href="#i-filter" /></svg><svg class="ico"><use href="#i-new" /></svg></span>
      </div>
      <ul class="side__list">
        <li class="card" data-row="nightly" data-p="row-nightly" data-k="nightly-row" data-gone>
          <div class="card__head"><span class="tile">HA</span><span class="card__repo">harbor/api</span><span class="card__meta card__meta--ok" data-k="nightly-st-done" data-gone><svg class="ico ico--sm"><use href="#i-check" /></svg>Done</span><span class="card__meta" data-k="nightly-st-time">02:14</span></div>
          <div class="card__title">Copy old uploads to S3</div>
          <div class="card__foot"><span><svg class="ico ico--xs"><use href="#i-cal-clock" /></svg>Every night 02:00</span><span>Codex</span></div>
        </li>
        <li class="card" data-row="s3" data-k="s3-row" data-gone>
          <div class="card__head"><span class="tile">HA</span><span class="card__repo">harbor/api</span><span class="card__meta card__meta--info" data-k="s3-st-work" data-gone><svg class="ico ico--sm"><use href="#i-working" /></svg>Working</span><span class="card__meta" data-k="s3-st-now">now</span></div>
          <div class="card__title">Move uploads to S3</div>
          <div class="card__foot"><span><svg class="ico ico--xs"><use href="#i-branch" /></svg>s3-uploads</span><span>Claude</span></div>
        </li>
        <li class="card" data-row="flaky" data-k="flaky-row" data-gone>
          <div class="card__head"><span class="tile">HW</span><span class="card__repo">harbor/web</span><span class="card__meta card__meta--info" data-k="flaky-st-work" data-gone><svg class="ico ico--sm"><use href="#i-working" /></svg>Working</span><span class="card__meta" data-k="flaky-st-now">now</span></div>
          <div class="card__title">Fix the flaky login test</div>
          <div class="card__foot"><span><svg class="ico ico--xs"><use href="#i-branch" /></svg>fix/login-flake</span><span>Codex</span></div>
        </li>
        <li class="card is-on" data-row="plan" data-k="plan-row">
          <div class="card__head"><span class="tile">HC</span><span class="card__repo">harbor/checkout</span><span class="card__meta card__meta--info" data-k="plan-st-work" data-gone><svg class="ico ico--sm"><use href="#i-working" /></svg>Working</span><span class="card__meta" data-k="plan-st-now">now</span></div>
          <div class="card__title">Add Apple Pay to checkout</div>
          <div class="card__foot"><span><svg class="ico ico--xs"><use href="#i-branch" /></svg>apple-pay</span><span>Claude</span></div>
        </li>
        <li class="card">
          <div class="card__head"><span class="tile">HB</span><span class="card__repo">harbor/billing</span><span class="card__meta">Waiting</span></div>
          <div class="card__title">Webhook retries charge twice</div>
          <div class="card__foot"><span><svg class="ico ico--xs"><use href="#i-branch" /></svg>fix/webhook-retry</span><span>Cursor</span></div>
        </li>
      </ul>
      <div class="shelf"><span>Settled</span><i></i><svg class="ico ico--xs"><use href="#i-chevron" /></svg></div>
      <ul class="side__list side__list--slim">
        <li class="slim"><span class="tile tile--dim">HB</span><span>Bump the Postgres driver</span><em>4d</em></li>
        <li class="slim"><span class="tile tile--dim">HB</span><span>Invoice PDFs embed fonts</span><em>5d</em></li>
      </ul>
    </aside>

    <div class="pane pane--chat" data-in="agents">
      <div class="chat">
        <!-- The planner: Claude, asked to plan, with its two subagents. -->
        <div class="chat__log" data-only="plan" data-off={off("plan")}>
          <div class="msg msg--user" data-k="plan-ask">
            Add Apple Pay to checkout. Plan it, then hand the API and the button to two agents, each in a worktree of its own.
          </div>
          <ul class="worklog">
            <li data-k="plan-read"><svg class="ico ico--xs"><use href="#i-eye" /></svg><span>Read <code>checkout/Checkout.tsx</code> +6 more</span></li>
          </ul>
          <div class="msg msg--agent" data-k="plan-reply-1">
            <p>Two pieces can run at once: a payment intents endpoint for Apple Pay, and the button in checkout that calls it. Codex takes the API, a second Claude the button.</p>
          </div>
          <div class="subs" data-k="plan-subs">
            <div class="subs__head">
              <span class="subs__avs"><span class="sub__av"><svg class="logo"><use href="#p-openai" /></svg></span><span class="sub__av"><svg class="logo"><use href="#p-claude" /></svg></span></span>
              <span class="sub__main">
                <b>2 subagents</b>
                <em class="sub__live" data-k="sub-2w" data-gone>2 working</em>
                <em class="sub__live" data-k="sub-1w" data-gone>1 working · 1 done</em>
                <em data-k="sub-2d">2 done</em>
              </span>
              <span class="sub__time">6m 05s</span>
              <svg class="ico ico--xs ico--muted sub__open"><use href="#i-chevron" /></svg>
            </div>
            <div class="subs__list">
              <div class="sub" data-p="card-a">
                <span class="sub__av"><svg class="logo"><use href="#p-openai" /></svg><i class="sub__dot sub__dot--run" data-k="a-run" data-gone></i><i class="sub__dot" data-k="a-done"></i></span>
                <span class="sub__main">
                  <b>Payment intents API <i data-k="a-run" data-gone>Running</i></b>
                  <em><span data-k="a-run" data-gone>Editing payments/intents.ts</span><span data-k="a-done">Opened #512. Tests pass.</span></em>
                </span>
                <span class="sub__time"><span data-k="a-run" data-gone>1m 08s</span><span data-k="a-done">4m 12s</span></span>
                <svg class="ico ico--xs ico--muted sub__go"><use href="#i-chevron" /></svg>
              </div>
              <div class="sub" data-p="card-b">
                <span class="sub__av"><svg class="logo"><use href="#p-claude" /></svg><i class="sub__dot sub__dot--run" data-k="b-run" data-gone></i><i class="sub__dot" data-k="b-done"></i></span>
                <span class="sub__main">
                  <b>Apple Pay button <i data-k="b-run" data-gone>Running</i></b>
                  <em><span data-k="b-run" data-gone>Reading checkout/PayButtons.tsx</span><span data-k="b-done">Opened #513. Falls back to the card form.</span></em>
                </span>
                <span class="sub__time"><span data-k="b-run" data-gone>1m 02s</span><span data-k="b-done">6m 05s</span></span>
                <svg class="ico ico--xs ico--muted sub__go"><use href="#i-chevron" /></svg>
              </div>
            </div>
          </div>
          <div class="sub sub--back" data-k="plan-back-a">
            <span class="sub__av"><svg class="logo"><use href="#p-openai" /></svg><i class="sub__dot"></i></span>
            <span class="sub__main"><b>Payment intents API <i>Finished</i></b><em>Opened #512. Tests pass.</em></span>
            <span class="sub__time">4:21 PM</span>
            <svg class="ico ico--xs ico--muted sub__go"><use href="#i-chevron" /></svg>
          </div>
          <div class="sub sub--back" data-k="plan-back-b">
            <span class="sub__av"><svg class="logo"><use href="#p-claude" /></svg><i class="sub__dot"></i></span>
            <span class="sub__main"><b>Apple Pay button <i>Finished</i></b><em>Opened #513. Falls back to the card form.</em></span>
            <span class="sub__time">4:23 PM</span>
            <svg class="ico ico--xs ico--muted sub__go"><use href="#i-chevron" /></svg>
          </div>
          <div class="msg msg--agent" data-k="plan-reply-2">
            <p>Both pieces are in: #512 adds the endpoint and #513 the button. Next, the Payments page in the wiki.</p>
          </div>
          <ul class="worklog" data-k="plan-wiki">
            <li><svg class="ico ico--xs"><use href="#i-book" /></svg><span>Amended a wiki <code>engineering/Payments</code></span></li>
          </ul>
          <div class="msg msg--agent" data-k="plan-reply-3">
            <p>The Payments page now covers Apple Pay. The edit waits in the change request Add Apple Pay to checkout.</p>
          </div>
        </div>

        <!-- The subagents and the reviewer: each opens on its parent, then the task it was sent. -->
        {
          threads.map((t) => (
            <div class="chat__log" data-only={t.id} data-off={off(t.id)}>
              <div class="divider">
                <svg class="ico ico--xs"><use href="#i-bot" /></svg>
                <span>Subagent of</span>
                <b>{t.parent}</b>
                <span class="divider__act">Open parent thread</span>
              </div>
              <div class="ask" data-k={`${t.id}-ask`}>
                <span class="ask__by">Sent by another agent</span>
                <div class="msg msg--user">{t.ask}</div>
              </div>
              <ul class="worklog">
                {t.steps.map((step) => (
                  <li data-k={step.k} data-gone={step.gone || undefined}>
                    <svg class="ico ico--xs"><use href={`#${step.icon}`} /></svg>
                    <span>
                      {step.text}
                      {step.code ? <code>{step.code}</code> : null}
                      {step.more}
                    </span>
                  </li>
                ))}
              </ul>
              <div class="msg msg--agent" data-k={`${t.id}-reply`}>
                <p set:html={t.reply} />
              </div>
            </div>
          ))
        }

        <!-- Fix the flaky login test: Codex fixes, Claude reviews. -->
        <div class="chat__log" data-only="flaky" data-off={off("flaky")}>
          <div class="msg msg--user" data-k="flaky-ask">Fix the flaky login test, then have Claude review the fix.</div>
          <ul class="worklog">
            <li data-k="flaky-read"><svg class="ico ico--xs"><use href="#i-eye" /></svg><span>Read <code>e2e/login.spec.ts</code> +2 more</span></li>
            <li data-k="flaky-c1"><svg class="ico ico--xs"><use href="#i-terminal" /></svg><code>pnpm test login --repeat 20</code></li>
            <li data-k="flaky-e1"><svg class="ico ico--xs"><use href="#i-square-pen" /></svg><code>e2e/login.spec.ts</code></li>
            <li data-k="flaky-live" data-gone><svg class="ico ico--xs"><use href="#i-terminal" /></svg><span>Running command</span></li>
            <li data-k="flaky-c2"><svg class="ico ico--xs"><use href="#i-terminal" /></svg><code>pnpm test login --repeat 50</code></li>
          </ul>
          <div class="msg msg--agent" data-k="flaky-reply-1">
            <p>The test clicked Sign in before the session cookie was set; 4 of 20 runs failed. It now waits for the cookie, and 50 runs pass. Asking Claude to review.</p>
          </div>
          <div class="sub" data-k="flaky-sub" data-p="card-rv">
            <span class="sub__av"><svg class="logo"><use href="#p-claude" /></svg><i class="sub__dot sub__dot--run" data-k="rv-run" data-gone></i><i class="sub__dot" data-k="rv-done"></i></span>
            <span class="sub__main">
              <b>Review the login test fix <i data-k="rv-run" data-gone>Running</i></b>
              <em><span data-k="rv-run" data-gone>Reading e2e/login.spec.ts</span><span data-k="rv-done">Assert the heading after the redirect.</span></em>
            </span>
            <span class="sub__time"><span data-k="rv-run" data-gone>24s</span><span data-k="rv-done">1m 40s</span></span>
            <svg class="ico ico--xs ico--muted sub__go"><use href="#i-chevron" /></svg>
          </div>
          <div class="sub sub--back" data-k="flaky-back">
            <span class="sub__av"><svg class="logo"><use href="#p-claude" /></svg><i class="sub__dot"></i></span>
            <span class="sub__main"><b>Review the login test fix <i>Finished</i></b><em>Assert the heading after the redirect.</em></span>
            <span class="sub__time">10:42 AM</span>
            <svg class="ico ico--xs ico--muted sub__go"><use href="#i-chevron" /></svg>
          </div>
          <ul class="worklog">
            <li data-k="flaky-e2"><svg class="ico ico--xs"><use href="#i-square-pen" /></svg><code>e2e/login.spec.ts</code></li>
          </ul>
          <div class="msg msg--agent" data-k="flaky-reply-2">
            <p>Claude found nothing blocking. I added its assertion; 50 runs still pass. Ready for a pull request.</p>
          </div>
        </div>

        <!-- Move uploads to S3: a pull request it watches, a task it schedules. -->
        <div class="chat__log" data-only="s3" data-off={off("s3")}>
          <div class="msg msg--user" data-k="s3-ask">Move uploads to S3. Copy the old files over a batch a night.</div>
          <ul class="worklog">
            <li data-k="s3-read"><svg class="ico ico--xs"><use href="#i-eye" /></svg><span>Read <code>storage/disk.ts</code> +4 more</span></li>
            <li data-k="s3-e1"><svg class="ico ico--xs"><use href="#i-square-pen" /></svg><code>storage/s3.ts</code></li>
            <li data-k="s3-e2"><svg class="ico ico--xs"><use href="#i-square-pen" /></svg><code>storage/index.ts</code></li>
            <li data-k="s3-live" data-gone><svg class="ico ico--xs"><use href="#i-terminal" /></svg><span>Running command</span></li>
            <li data-k="s3-run"><svg class="ico ico--xs"><use href="#i-terminal" /></svg><code>pnpm test storage</code></li>
            <li data-k="s3-pr"><svg class="ico ico--xs"><use href="#i-terminal" /></svg><code>gh pr create</code></li>
            <li data-k="s3-watch"><svg class="ico ico--xs"><use href="#i-pr" /></svg><span>Watching a pull request <code>#530</code></span></li>
            <li data-k="s3-sched"><svg class="ico ico--xs"><use href="#i-cal-clock" /></svg><span>Scheduled a recurring task <code>Every night 02:00</code></span></li>
          </ul>
          <div class="msg msg--agent" data-k="s3-reply">
            <p>New uploads go to S3, behind the same storage interface. I opened #530 and I’m watching it. Every night at 02:00 a task copies the next 10,000 old files.</p>
          </div>
        </div>

        <!-- The scheduled task's first run, in a thread of its own. -->
        <div class="chat__log" data-only="nightly" data-off={off("nightly")}>
          <div class="ask" data-k="nightly-ask">
            <span class="ask__by">Sent by automation</span>
            <div class="msg msg--user">Copy the next 10,000 files from disk to S3, check them, and report what is left.</div>
          </div>
          <ul class="worklog">
            <li data-k="nightly-run"><svg class="ico ico--xs"><use href="#i-terminal" /></svg><code>node scripts/copy-uploads.js --batch 10000</code></li>
          </ul>
          <div class="msg msg--agent" data-k="nightly-reply">
            <p>Copied 10,000 files and their checksums match. 31,200 to go, about four more nights.</p>
          </div>
        </div>
      </div>
      <div class="composer">
        <div class="composer__input">
          <span class="composer__hint" data-k="placeholder">Ask anything, @tag files/folders, $use skills, or / for commands</span>
          <span data-k="draft-apple" data-gone>Add Apple Pay to checkout. Plan it, then hand the API and the button to two agents, each in a worktree of its own.</span>
          <span data-k="draft-flaky" data-gone>Fix the flaky login test, then have Claude review the fix.</span>
          <span data-k="draft-s3" data-gone>Move uploads to S3. Copy the old files over a batch a night.</span>
        </div>
