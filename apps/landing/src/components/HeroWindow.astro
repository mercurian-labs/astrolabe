---
// The hero's drawn window: Threads, Wikis and Changes in one app frame, each section's surfaces
// authored here and driven by scripts/tour.js. As written (no script) it is the tour's last
// Threads state: the fork on Claude, its lane in Lineage. Anything named data-k is a part the tour
// shows or hides; data-gone marks a part the finished still leaves out; data-only marks a part of
// one thread's view ("codex" or "fork").
import { files, steps } from "../scripts/tour-scenes.js";

const added = files.reduce((sum, file) => sum + file.added, 0);
const removed = files.reduce((sum, file) => sum + file.removed, 0);
