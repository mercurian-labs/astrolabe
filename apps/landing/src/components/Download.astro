---
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../scripts/releases.js";
import "../styles/download.css";

interface Props {
  /** Nightly is the QA channel: its page is unlisted, and the stable page opens a door to it only at night. */
  channel: "stable" | "nightly";
}

const { channel } = Astro.props;
const nightly = channel === "nightly";

const APP_URL = "https://app.astrolabe.sh";
const CLI = "npx @mercurian/astrolabe@latest";

// The lead offers one build for the visitor's computer, picked before the first paint by the inline
// script below (and refined by scripts/download.js where the browser reports its architecture).
// Each `asset` is the tail of a release file's name: Astrolabe-<version>-<asset>.
const leads = [
  { id: "mac", label: "Download for macOS", asset: "arm64.dmg", caption: "Apple Silicon · .dmg", alt: { label: "Intel Mac", asset: "x64.dmg" } },
  { id: "linux", label: "Download for Linux", asset: "x86_64.AppImage", caption: "x86_64 · AppImage", alt: { label: ".deb", asset: "amd64.deb" } },
  { id: "linux-arm64", label: "Download for Linux", asset: "arm64.AppImage", caption: "arm64 · AppImage", alt: { label: ".deb", asset: "arm64.deb" } },
];

// Every build, by platform, in the order the cards list them. A platform without `files` is drawn as
// coming soon.
const desktop = [
  {
    id: "mac",
    name: "macOS",
    glyph: "g-apple",
    files: [
      { label: "Apple Silicon", format: ".dmg", asset: "arm64.dmg" },
      { label: "Intel", format: ".dmg", asset: "x64.dmg" },
    ],
  },
  {
    id: "win",
    name: "Windows",
    glyph: "g-windows",
    soon: "The Windows app follows the first release. Until then, run Astrolabe from the command line.",
  },
  {
    id: "linux",
    name: "Linux",
    glyph: "g-linux",
    files: [
      { label: "x86_64", format: "AppImage", asset: "x86_64.AppImage" },
      { label: "arm64", format: "AppImage", asset: "arm64.AppImage" },
      { label: "Debian, Ubuntu · amd64", format: ".deb", asset: "amd64.deb" },
      { label: "Debian, Ubuntu · arm64", format: ".deb", asset: "arm64.deb" },
    ],
  },
];
---

<Layout
  title={nightly ? "Nightly · Astrolabe" : "Download · Astrolabe"}
  description={
    nightly
      ? "Astrolabe Nightly, built from main every night for testing."
      : "Download Astrolabe for macOS and Linux, run it from the command line, or open it in your browser."
  }
  noindex={nightly}
  image={{ src: "/og/page-download.jpg", alt: "Download, Astrolabe, printed on a two-ink print of Mercury" }}
>
  <Header />

  <svg class="sprite" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <symbol id="i-down" viewBox="0 0 16 16"><path d="M8 2.5v10M4 8.5l4 4 4-4" /></symbol>
      <!-- Platform marks, flat in the ink they sit on. -->
      <symbol id="g-apple" viewBox="0 0 814 1000"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z" /></symbol>
      <symbol id="g-windows" viewBox="0 0 24 24"><path fill="currentColor" d="M3 3h8.4v8.4H3zM12.6 3H21v8.4h-8.4zM3 12.6h8.4V21H3zM12.6 12.6H21V21h-8.4z" /></symbol>
      <symbol id="g-linux" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M12 1.6c-2.7 0-4 2.2-4 4.9 0 1.6.3 2.6-.6 3.9C6.2 12.1 5 14.3 5 16.7c0 3 2.8 4.9 7 4.9s7-1.9 7-4.9c0-2.4-1.2-4.6-2.4-6.3-.9-1.3-.6-2.3-.6-3.9 0-2.7-1.3-4.9-4-4.9zm0 8.6c-2 0-3.5 2.6-3.5 5.6 0 2.4 1.5 4 3.5 4s3.5-1.6 3.5-4c0-3-1.5-5.6-3.5-5.6zM10.5 5.2a.95.95 0 1 0 0 1.9.95.95 0 0 0 0-1.9zm3 0a.95.95 0 1 0 0 1.9.95.95 0 0 0 0-1.9zM10.6 8.1h2.8L12 9.6z" /><path fill="currentColor" d="M5 21.4c0-.9 1.4-1.7 3.2-1.7s2.6.8 2.6 1.7-1 1.2-2.9 1.2S5 22.3 5 21.4zM13.2 21.4c0-.9.8-1.7 2.6-1.7s3.2.8 3.2 1.7-1.1 1.2-2.9 1.2-2.9-.3-2.9-1.2z" /></symbol>
      <symbol id="g-android" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M3 18a9 9 0 0 1 18 0zM8.6 13.4a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4zm6.8 0a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z" /><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="M7.4 11 5.4 7.4M16.6 11l2-3.6" /></symbol>
      <symbol id="g-browser" viewBox="0 0 24 24"><rect x="2.75" y="4.25" width="18.5" height="15.5" /><path d="M2.75 8.75h18.5M6 6.5h.01M8.5 6.5h.01M11 6.5h.01" /></symbol>
    </defs>
  </svg>

  <main id="main" class="dl" data-download data-channel={channel} data-platform="other" data-release="pending">
    <div class="dl__head">
      <div class="dl__lead">
        {
          nightly ? (
            <>
              <p class="tag">Download · Nightly</p>
              <h1 class="dl__title">Astrolabe Nightly.</h1>
              <p class="dl__lede">
                Built from main every night, so changes get tested before they reach a stable release. Expect bugs. It
                installs as Astrolabe (Nightly) and updates itself to each new nightly.
              </p>
            </>
          ) : (
            <>
              <p class="tag">Download</p>
              <h1 class="dl__title">Astrolabe for your computer.</h1>
              <p class="dl__lede">
                The desktop app runs your agents on the machine where your code lives, and serves Astrolabe to your
                browser and phone from there.
              </p>
            </>
          )
        }

        <div class="dl__act">
          {
            leads.map((lead) => (
              <div class="dl__choice" data-lead={lead.id} hidden>
                <div class="dl__buttons">
                  <a class="btn btn--rust px px--on-rust" href={RELEASES_URL} data-asset={lead.asset}>
                    <span class="roll">
                      <span>{lead.label}</span>
                      <span aria-hidden="true">{lead.label}</span>
                    </span>
                    <svg class="arw arw--down" aria-hidden="true">
                      <use href="#i-down" />
                    </svg>
                  </a>
                  <a class="btn px" href={RELEASES_URL} data-asset={lead.alt.asset}>
                    <span class="roll">
                      <span>{lead.alt.label}</span>
                      <span aria-hidden="true">{lead.alt.label}</span>
                    </span>
                  </a>
                </div>
                <p class="tag dl__caption">{lead.caption}</p>
              </div>
            ))
          }
          <div class="dl__choice" data-lead="win" hidden>
            <div class="dl__buttons">
              <a class="btn btn--rust px px--on-rust" href="#direct">
                <span class="roll"><span>Run it from a terminal</span><span aria-hidden="true">Run it from a terminal</span></span>
                <svg class="arw arw--down" aria-hidden="true"><use href="#i-down" /></svg>
              </a>
            </div>
            <p class="tag dl__caption">The Windows app is coming soon · macOS and Linux are ready</p>
          </div>
          <div class="dl__choice" data-lead="mobile" hidden>
            <div class="dl__buttons">
              <a class="btn btn--rust px px--on-rust" href="#desktop">
                <span class="roll"><span>All downloads</span><span aria-hidden="true">All downloads</span></span>
                <svg class="arw arw--down" aria-hidden="true"><use href="#i-down" /></svg>
              </a>
            </div>
            <p class="tag dl__caption">Astrolabe installs on a computer · the phone apps are coming soon</p>
          </div>
          <div class="dl__choice" data-lead="other">
            <div class="dl__buttons">
              <a class="btn btn--rust px px--on-rust" href="#desktop">
                <span class="roll"><span>Choose a download</span><span aria-hidden="true">Choose a download</span></span>
                <svg class="arw arw--down" aria-hidden="true"><use href="#i-down" /></svg>
              </a>
            </div>
            <p class="tag dl__caption">macOS · Linux · Windows soon</p>
          </div>
          {/* Before paint: the visitor's platform from the user agent, so the right choice is the first one drawn. */}
          <script is:inline>
            {
              const page = document.currentScript.closest("[data-download]");
              const ua = navigator.userAgent;
              const hint = navigator.userAgentData?.platform || ua;
              const platform =
                /iPhone|iPad|iPod|Android/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)
                  ? "mobile"
                  : /mac/i.test(hint)
                    ? "mac"
                    : /win/i.test(hint)
                      ? "win"
                      : /linux|x11/i.test(hint) && !/CrOS/.test(ua)
                        ? "linux"
                        : "other";
              page.dataset.platform = platform;
              if (platform === "linux" && /aarch64|arm64/i.test(ua)) page.dataset.arch = "arm64";
              for (const lead of page.querySelectorAll("[data-lead]"))
                lead.hidden = lead.dataset.lead !== (page.dataset.arch ? `${platform}-arm64` : platform);
            }
          </script>

          <div class="dl__soon" role="status">
            {
              nightly ? (
                <>
                  <p class="dl__soon-title">No nightly yet</p>
                  <p>No nightly build has been published. The next one will be listed here.</p>
                </>
              ) : (
                <>
                  <p class="dl__soon-title">Coming soon</p>
                  <p>
                    The first release of Astrolabe for macOS and Linux is on its way. Its builds will be listed here the
                    day it ships, and Windows follows.
                  </p>
                </>
              )
            }
          </div>
        </div>
      </div>

      <aside class="dl__block" aria-label="Latest release">
        <span class="cross cross--tl"></span>
        <span class="cross cross--br"></span>
        <dl class="dl__sheet">
          <div><dt class="tag">Product</dt><dd>Astrolabe desktop</dd></div>
          <div><dt class="tag">Channel</dt><dd>{nightly ? "Nightly" : "Stable"}</dd></div>
          <div><dt class="tag">Version</dt><dd data-release-version>—</dd></div>
          <div><dt class="tag">Published</dt><dd data-release-published>—</dd></div>
          {nightly && <div><dt class="tag">Commit</dt><dd><a data-release-commit>—</a></dd></div>}
          <div><dt class="tag">Platforms</dt><dd>macOS · Linux</dd></div>
        </dl>
        <a class="link dl__notes" href={RELEASES_URL} data-release-link target="_blank" rel="noopener noreferrer">
          Release notes<svg class="arw" aria-hidden="true"><use href="#i-arrow" /></svg>
        </a>
      </aside>
    </div>

    <!-- ───────────────────────────────────────── [01] Desktop -->
    <section class="dl__sec" id="desktop" aria-labelledby="desktop-title">
      <div class="dl__sec-head">
        <p class="tag">[01] Desktop</p>
        <h2 id="desktop-title" class="dl__h2">Every build</h2>
        <p class="body">An installer for each platform and processor, all from the same release.</p>
      </div>
      <ul class="dl__cards dl__cards--3">
        {
          desktop.map((os, index) => (
            <li class:list={["dl__card", `dl__card--${os.id}`, os.soon && "dl__card--soon"]}>
              <p class="dl__rail tag">
                <span>{os.name}</span>
                <span class="dl__num">[{String(index + 1).padStart(2, "0")}]</span>
                <span class="dl__yours">Your computer</span>
              </p>
              <svg class="dl__glyph" aria-hidden="true">
                <use href={`#${os.glyph}`} />
              </svg>
              {os.soon ? (
                <>
                  <p class="dl__card-body">{os.soon}</p>
                  <p class="tag dl__card-note">Coming soon</p>
                </>
              ) : (
                <ul class="dl__files">
                  {(os.files ?? []).map((file) => (
                    <li>
                      <a class="dl__file" href={RELEASES_URL} data-asset={file.asset}>
                        <span class="dl__file-label">{file.label}</span>
                        <span class="tag dl__file-format">{file.format}</span>
                        <svg class="arw arw--down" aria-hidden="true">
                          <use href="#i-down" />
                        </svg>
                        <span class="tag dl__file-soon">Soon</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    {
      !nightly && (
        <>
          {/* ───────────────────────────────────────── [02] Without installing */}
          <section class="dl__sec" id="direct" aria-labelledby="direct-title">
            <div class="dl__sec-head">
              <p class="tag">[02] Without the app</p>
              <h2 id="direct-title" class="dl__h2">From a terminal or a browser</h2>
              <p class="body">The same Astrolabe, without the desktop app around it.</p>
            </div>
            <ul class="dl__cards dl__cards--2">
              <li class="dl__card">
                <p class="dl__rail tag"><span>Command line</span><span class="dl__num">[01]</span></p>
                <svg class="dl__glyph dl__glyph--line" aria-hidden="true"><use href="#i-terminal" /></svg>
                <p class="dl__card-body">
                  Run it once without installing: it starts the server on this computer and opens Astrolabe in your browser.
                  Needs Node.js 22.16 or 24.10 and later.
                </p>
                <div class="dl__cmd">
                  <code>{CLI}</code>
                  <button class="dl__copy px" type="button" data-copy={CLI} aria-label={`Copy ${CLI}`}>
                    <svg aria-hidden="true"><use href="#i-copy" /></svg>
                    <span data-copy-label aria-live="polite">Copy</span>
                  </button>
                </div>
                <p class="tag dl__card-note dl__card-note--soon">Published with the first release</p>
              </li>
              <li class="dl__card">
                <p class="dl__rail tag"><span>Browser</span><span class="dl__num">[02]</span></p>
                <svg class="dl__glyph dl__glyph--line" aria-hidden="true"><use href="#g-browser" /></svg>
                <p class="dl__card-body">
                  Open Astrolabe from any browser at app.astrolabe.sh, and pair it with a computer running Astrolabe that it
                  can reach over HTTPS, such as through Tailscale.
                </p>
                <a class="link dl__card-link" href={APP_URL}>
                  Open app.astrolabe.sh<svg class="arw" aria-hidden="true"><use href="#i-arrow" /></svg>
                </a>
              </li>
            </ul>
          </section>

          {/* ───────────────────────────────────────── [03] On your phone */}
          <section class="dl__sec" aria-labelledby="phone-title">
            <div class="dl__sec-head">
              <p class="tag">[03] On your phone</p>
              <h2 id="phone-title" class="dl__h2">Steer from your phone</h2>
              <p class="body">Get notified when an agent needs you, and answer from wherever you are.</p>
            </div>
            <ul class="dl__cards dl__cards--2">
              <li class="dl__card dl__card--soon">
                <p class="dl__rail tag"><span>iPhone</span><span class="dl__num">[01]</span></p>
                <svg class="dl__glyph" aria-hidden="true"><use href="#g-apple" /></svg>
                <p class="dl__card-body">The iPhone app connects to the computers running Astrolabe.</p>
                <p class="tag dl__card-note">Coming soon to the App Store</p>
              </li>
              <li class="dl__card dl__card--soon">
                <p class="dl__rail tag"><span>Android</span><span class="dl__num">[02]</span></p>
                <svg class="dl__glyph" aria-hidden="true"><use href="#g-android" /></svg>
                <p class="dl__card-body">The Android app connects to the computers running Astrolabe.</p>
                <p class="tag dl__card-note">Coming soon to Google Play</p>
              </li>
            </ul>
          </section>
        </>
      )
    }

    <p class="dl__all">
      Every build, with SHA-256 checksums, is on the
      <a href={RELEASES_URL} data-release-link target="_blank" rel="noopener noreferrer">releases page</a>.
    </p>

    {/* Stable opens a door to the QA channel only while the page is in night (data-twilight, from the visitor's sun). */}
    {
      nightly ? (
        <p class="dl__all">
          For everyday work, use the <a href="/download">stable release</a>.
        </p>
      ) : (
        <p class="dl__night">
          <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M8.79 4.46A6 6 0 1 0 15.48 11.58A5 5 0 0 1 8.79 4.46Z" /></svg>
          <span>
            After dark, the <a href="/download/nightly">nightly builds</a>: made from main every night for testing, and
            sometimes broken.
          </span>
        </p>
      )
    }
  </main>

  <Footer />
</Layout>

<script>
  import "../scripts/download.js";
</script>
