# Cloudflare Workers static assets headers for the hosted app (apps/web/wrangler.jsonc). Kept out
# of public/ so the server-bundled client never carries it. index.html and the other unhashed
# files get the platform default, `public, max-age=0, must-revalidate`, so a release reaches an
# open tab on its next load.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000

# Vite's content-hashed bundles.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
