# Settings for `vp run dev`, the local relay. Placeholders only, no secrets:
# local dev has no custom domains, tunnels or push.
RELAY_API_ZONE_NAME=localhost
RELAY_TUNNEL_ZONE_NAME=localhost
APNS_ENABLED=false
# The local cloud API: set this to the apiUrl `vp run dev` prints in infra/cloud.
# Its tokens name http://localhost:8787 as audience.
ACCOUNT_JWT_ISSUER=http://localhost:4310
