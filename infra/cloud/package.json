{
  "name": "mercurian-cloud-infra",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "scripts": {
    "build": "vp pack && mkdir -p dist/migrate/migrations && cp -R ../../apps/cloud/migrations/auth dist/migrate/migrations/auth && cp -R ../relay/migrations/postgres dist/migrate/migrations/relay",
    "dev": "vp run --filter @mercurian/auth build && alchemy dev",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "typecheck": "tsc --noEmit",
    "test:integration": "test/integration.sh"
  },
  "dependencies": {
    "@alchemy.run/aws": "catalog:",
    "@alchemy.run/docker": "catalog:",
    "@alchemy.run/drizzle": "catalog:",
    "@distilled.cloud/aws": "catalog:",
    "@effect/platform-bun": "4.0.2",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@mercurian/auth": "workspace:*",
    "@mercurian/cloud": "workspace:*",
    "alchemy": "catalog:",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
