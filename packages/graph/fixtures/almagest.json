  "lenses": [
    {
      "name": "Decisions",
      "types": {
        "informs": "The source supplies context or constraints for decisions about the destination."
      },
      "edges": [
        {
          "from": "Memory",
          "type": "informs",
          "to": "Skill Maps",
          "rationale": "Memory delegates the interpretation and surfacing of decision conventions to skill-map teaching."
        },
        {
          "from": "Skill Maps",
          "type": "informs",
          "to": "Skills",
          "rationale": "The map protocol specializes the base teaching that Skills defines."
        },
        {
          "from": "Memory",
          "type": "informs",
          "to": "Composer",
          "rationale": "Memory describes how open forks can become offers in the composer through teaching."
        },
        {
          "from": "Threads",
          "type": "informs",
          "to": "DAG",
          "rationale": "A thread is one line; how threads fork and take context from one another is where human-controlled branching now constrains work history (2026-09-24; formerly this edge reached the Commit Tree)."
        },
        {
          "from": "Skill Maps",
          "type": "informs",
          "to": "Atlas Graph",
          "rationale": "Skill Maps fixes the web reading for cyclic graphs, the shared camera, and the lens rule, arrangement over the graph and never in it, that the Atlas Graph's forks are resolved against (2026-09-24)."
        }
      ]
    },
    {
      "name": "Product",
      "types": {
        "contains": "The destination is a constituent part of the source."
