# Optional: cloud features (sign-in, workspaces, remote access) in source builds
# Astrolabe's cloud isn't deployed yet, so the production values below are
# commented out and builds have every cloud feature hidden. Uncomment both once
# app.astrolabe.sh sign-in and relay.astrolabe.sh are live, or point them at a
# local cloud stack. These are public identifiers, not secrets.
# Do not add server-side secrets to this file.

# Astrolabe sign-in. For a local cloud stack, use the API URL that
# `vp run dev` prints in infra/cloud (plain HTTP works on localhost only).
# T3CODE_AUTH_URL=https://app.astrolabe.sh

# Optional: signed macOS builds.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile

# Astrolabe's production relay. For a self-hosted relay, `infra/relay` deploys
# update it automatically.
# T3CODE_RELAY_URL=https://relay.astrolabe.sh

# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
